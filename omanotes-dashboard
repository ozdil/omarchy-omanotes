#!/usr/bin/env bash
set -euo pipefail

# Toggle native Quickshell UI if running
if command -v quickshell >/dev/null 2>&1; then
    if quickshell ipc -p /usr/share/omarchy/shell call ozdil.omanotes toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/omanotes-engine"

if [[ -x "${BIN}" ]]; then
    exec "${BIN}" "$@"
else
    echo "OmaNotes engine not found. Run ./build.sh first."
    exit 1
fi
