#!/usr/bin/env bash
set -euo pipefail

# Toggle native Quickshell UI if running
if command -v quickshell >/dev/null 2>&1; then
    if quickshell ipc -p /usr/share/omarchy/shell call ozdil.omanotes toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${DIR}/omanotes-engine"

if [[ ! -x "${BIN}" ]]; then
    echo "OmaNotes engine not found. Compiling from source..." >&2
    (cd "${DIR}" && cargo build --release --locked && install -m 755 target/release/omanotes-engine "${BIN}") >&2
fi

exec "${BIN}" "$@"
